<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WyrdStack.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WyrdStack.Maui.Views"
    xmlns:auth="clr-namespace:WyrdStack.Maui.Views.Auth"
    Title="WyrdStack.Maui" FlyoutBehavior="Flyout">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="LoginPage" FlyoutItemIsVisible="False"/>
    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate auth:RegisterPage}"
        Route="RegisterPage" FlyoutItemIsVisible="False"/>
</Shell>
