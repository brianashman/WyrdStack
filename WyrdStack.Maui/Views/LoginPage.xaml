<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WyrdStack.Maui.ViewModels"
             x:Class="WyrdStack.Maui.Views.LoginPage"
             Title="LoginPage" x:DataType="vm:LoginPageViewModel">
    <Border Background="LightSteelBlue" StrokeShape="RoundRectangle 10" x:Name="LoginBorder">
        <Grid RowDefinitions="Auto, *, Auto" Padding="20">
            <Label Text="Login" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <VerticalStackLayout Padding="20" Spacing="10">
                <Entry x:Name="UsernameEntry" Placeholder="Username" MaxLength="20" />
                <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="{Binding IsPassword}" 
                       Text="{Binding Password}" MaxLength="64"/>
                <HorizontalStackLayout Spacing="5">
                    <CheckBox x:Name="ShowPasswordCheckBox" 
                              Command="{Binding TogglePasswordVisibilityCommand}" />
                    <Label Text="Show Password" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Text="Login" Command="{Binding LoginCommand}" CommandParameter="{Binding Source={x:Reference UsernameEntry}, Path=Text}"/>
                <Label Text="{Binding LoginStatusMessage}" TextColor="Red" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentPage>