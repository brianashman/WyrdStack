<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WyrdStack.Maui.ViewModels"
             xmlns:uranium="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:uraniumcore="clr-namespace:UraniumUI.Controls;assembly=UraniumUI"
             
             x:Class="WyrdStack.Maui.Views.MainPage"
             x:DataType="vm:MainPageViewModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
        <Label Text="{Binding CpuCoreCount}"/>
        <Label Text="{Binding Uptime}" />
        <Label Text="{Binding TotalMemoryBytes}" />
        <Label Text="{Binding TotalStorageBytes}" />
    </VerticalStackLayout>


</ContentPage>
